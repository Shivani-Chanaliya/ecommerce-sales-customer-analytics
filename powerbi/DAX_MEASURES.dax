-- Create these as measures after importing the FactSales and dimensions.
-- FactSales[TransactionStatus] is generated by the Python pipeline.

Total Revenue =
CALCULATE(
    SUM(FactSales[Revenue]),
    FactSales[TransactionStatus] = "Sale"
)

Total Orders =
CALCULATE(
    DISTINCTCOUNT(FactSales[InvoiceNo]),
    FactSales[TransactionStatus] = "Sale"
)

Total Customers =
CALCULATE(
    DISTINCTCOUNT(FactSales[CustomerID]),
    FactSales[TransactionStatus] = "Sale",
    FactSales[CustomerID] <> BLANK()
)

Average Order Value =
DIVIDE([Total Revenue], [Total Orders])

Revenue Previous Month =
CALCULATE(
    [Total Revenue],
    DATEADD(DimDate[Date], -1, MONTH)
)

Revenue Growth % =
DIVIDE(
    [Total Revenue] - [Revenue Previous Month],
    [Revenue Previous Month]
)

Repeat Customers =
VAR CustomerOrderCounts =
    ADDCOLUMNS(
        FILTER(
            VALUES(FactSales[CustomerID]),
            NOT ISBLANK(FactSales[CustomerID])
        ),
        "@OrderCount", CALCULATE([Total Orders])
    )
RETURN
    COUNTROWS(FILTER(CustomerOrderCounts, [@OrderCount] > 1))

Repeat Customer Rate % =
DIVIDE([Repeat Customers], [Total Customers])

New Customers =
VAR PeriodStart = MIN(DimDate[Date])
VAR PeriodEnd = MAX(DimDate[Date])
VAR CustomersWithFirstOrder =
    ADDCOLUMNS(
        FILTER(
            VALUES(DimCustomer[CustomerID]),
            NOT ISBLANK(DimCustomer[CustomerID])
        ),
        "@FirstOrderDate",
            CALCULATE(
                MIN(FactSales[OrderDate]),
                REMOVEFILTERS(DimDate),
                FactSales[TransactionStatus] = "Sale"
            )
    )
RETURN
    COUNTROWS(
        FILTER(
            CustomersWithFirstOrder,
            [@FirstOrderDate] >= PeriodStart
                && [@FirstOrderDate] <= PeriodEnd
        )
    )

Returning Customers =
[Total Customers] - [New Customers]

Average Historical Revenue per Customer =
DIVIDE([Total Revenue], [Total Customers])

Product Revenue Rank =
RANKX(
    ALLSELECTED(DimProduct[StockCode]),
    [Total Revenue],
    ,
    DESC,
    DENSE
)

Cancelled Invoices =
CALCULATE(
    DISTINCTCOUNT(FactSales[InvoiceNo]),
    FactSales[TransactionStatus] = "Cancelled"
)

All Invoice IDs =
DISTINCTCOUNT(FactSales[InvoiceNo])

Cancelled Invoice Share % =
DIVIDE([Cancelled Invoices], [All Invoice IDs])

Cohort Retention % =
MAX(FactCohortRetention[RetentionPct])
